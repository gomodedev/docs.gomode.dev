{
  "name": "docs-gomode-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "python3 scripts/update_agents_file_index.py --check && vitepress build",
    "preview": "vitepress preview",
    "deploy": "pnpm run build && wrangler deploy",
    "fix": "python3 scripts/update_agents_file_index.py",
    "verify": "python3 scripts/update_agents_file_index.py --check"
  },
  "devDependencies": {
    "medium-zoom": "^1.1.0",
    "vitepress": "^1.6.3",
    "wrangler": "^4.68.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  }
}
