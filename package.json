{
  "name": "docs-gomode-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run verify && vitepress build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vitepress dev",
    "fix": "prettier --write . && python3 scripts/update_agents_file_index.py",
    "prepare": "scripts/install-git-hooks.sh",
    "verify": "prettier --check . && python3 scripts/update_agents_file_index.py --check && python3 scripts/check_screenshots.py && tsc --noEmit",
    "preview": "vitepress preview",
    "test": "pnpm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitepress": "^1.6.4",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
