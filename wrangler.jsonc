// Static Go Mode website assets and custom-domain routing.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-gomode-dev",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "docs.gomode.dev",
      "custom_domain": true,
    },
  ],
}
